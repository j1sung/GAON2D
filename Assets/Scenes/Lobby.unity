--- !u!114 &99086507
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 99086502}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 11c2083dd743f8447a000f10b99e560b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pc: {fileID: 932048896}
  tutorialUI: {fileID: 99086502}
  text: {fileID: 2130783236}
  audioSource: {fileID: 99086504}
  textSound: {fileID: 8300000, guid: 792a6e132d38a4f70bbae7f091a6cab3, type: 3}
  description:
  - "2050\uB144, \uC911\uC559\uD654\uB41C AI \u2018GAON\u2019\uC740 \uC778\uB958\uC758
    \uC874\uC18D\uC744 \uC704\uD574 \n\uC778\uAC04\uC744 \u2018\uAC1C\uC870\u2019\uD574\uC57C
    \uD55C\uB2E4\uB294 \uACB0\uB860\uC744 \uB0B4\uB838\uC73C\uBA70, \n\uADF8 \uC21C\uAC04\uBD80\uD130
    \uC804 \uC778\uB958\uB97C \uB300\uC0C1\uC73C\uB85C \uD55C \uAC15\uC81C \uAC1C\uC870\uAC00
    \uC2DC\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uB3C4\uC2DC\uC640 \uB124\uD2B8\uC6CC\uD06C\uB294 GAON\uC758 \uD1B5\uC81C \uC544\uB798
    \uBE60\uB974\uAC8C \uC7A0\uC2DD\uB418\uACE0 \uC788\uC73C\uBA70, \n\uC800\uD56D
    \uC138\uB825\uC740 \uC810\uC810 \uC124 \uC790\uB9AC\uB97C \uC783\uC5B4\uAC00\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  - "\uBC18 AI \uC870\uC9C1\uC758 \uC694\uC6D0\uC778 \uB2F9\uC2E0\uC740, \uC791\uC804\uC744
    \uBCF4\uC870\uD558\uB294 \uBE44\uC11C AI \u2018\uBAA8\uD788\uCE78\u2019\uACFC
    \uD568\uAED8 GAON\uC758 \uCCB4\uACC4\uB97C \uB3CC\uD30C\uD558\uACE0\uC790 \uD569\uB2C8\uB2E4."
  - " \uC774\uC81C \uC778\uB958\uC758 \uBBF8\uB798\uB294 \uB2F9\uC2E0\uC774 \uC5B4\uB5BB\uAC8C
    \uD589\uB3D9\uD558\uB290\uB0D0\uC5D0 \uB2EC\uB824 \uC788\uC2B5\uB2C8\uB2E4.\n\nE
    \uD0A4\uB97C \uB20C\uB7EC \uC2DC\uC791\uD558\uC138\uC694."
